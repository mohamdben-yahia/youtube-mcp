# YouTube Data API v3 Key (Single key)
# Activate :https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Obtain one from Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Multi-Key Quota Rotation Pool (Optional, comma-separated for automatic failover)
# YOUTUBE_API_KEYS=key_1,key_2,key_3

# Hosted Server Security (Required when running --transport sse or in Docker)
# Set your secret token, or leave empty/auto to auto-generate a secure token on startup
MCP_AUTH_KEY=your_secret_mcp_auth_token_here

# Intelligent Quota Caching (Optional)
YOUTUBE_CACHE_ENABLED=true
YOUTUBE_CACHE_DIR=~/.cache/youtube_mcp
YOUTUBE_CACHE_TTL=3600
